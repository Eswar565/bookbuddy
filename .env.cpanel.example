# Copy into a PRIVATE .env and set BOOK_BUDDY_ENV_FILE in cPanel.
# Replace CPANELUSER and library.example.com with your actual values.
SECRET_KEY=
COOKIE_SECURE=1
FLASK_DEBUG=0
BOOK_BUDDY_DATABASE=/home2/CPANELUSER/private/bookbuddy.sqlite3
BOOK_BUDDY_PRIVATE_DIR=/home2/CPANELUSER/private/bookbuddy-files
BOOK_BUDDY_BACKUP_DIR=/home2/CPANELUSER/private/bookbuddy-backups
SITE_URL=https://library.example.com
PUBLIC_BASE_URL=https://library.example.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MEMBERSHIP_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_NOTIFICATIONS=0
ACCOUNT_BOOK_LIMIT=2
ACCOUNT_LOAN_DAYS=14
