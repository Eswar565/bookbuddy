# ==========================================
# Book Buddy Configuration (.env)
# ==========================================

# Demo Mode switch: 1 enables the demo banner, sets noindex/nofollow,
# disallows robots.txt, disables outgoing email/payments, and rate-limits login.
DEMO_MODE=1

# Application security
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
COOKIE_SECURE=1

# Initial Administrator Credentials (used by setup / make_demo_data)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# Persistent Storage Paths (SQLite database and uploaded media)
# For Render / Railway / persistent-disk hosts:
# BOOK_BUDDY_DATABASE=/var/data/book_buddy.sqlite3
# MEDIA_ROOT=/var/data/media
# For local / cPanel deployments:
BOOK_BUDDY_DATABASE=instance/book_buddy.sqlite3
MEDIA_ROOT=media

# Payment Gateway (leave blank in demo mode to return "not configured" message)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MEMBERSHIP_WEBHOOK_SECRET=

# AI Features (leave blank if unused)
GEMINI_API_KEY=

# App Environment & Networking
APP_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SITE_URL=http://127.0.0.1:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Optional Outgoing SMTP (disabled when DEMO_MODE=1)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_NOTIFICATIONS=0

# Lending limits
ACCOUNT_BOOK_LIMIT=2
ACCOUNT_LOAN_DAYS=14
